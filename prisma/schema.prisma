generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                    @id @default(uuid())
  email         String                    @unique
  fullName      String?
  role          UserRole                  @default(CUSTOMER)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?
  bookings      Booking[]
  businesses    Business[]
  comments      Comment[]
  conversations ConversationParticipant[]
  favorites     Favorite[]
  likes         Like[]
  messages      Message[]
  notifications Notification[]
  profile       Profile?
  reviews       Review[]
  communities   Community[]               @relation("CommunityMembers")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  avatarUrl String?
  bio       String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  taxId     String?
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  owner     User      @relation(fields: [ownerId], references: [id])
  payouts   Payout[]
  venues    Venue[]

  @@index([ownerId])
}

model Venue {
  id                String            @id @default(uuid())
  businessId        String
  slug              String            @unique
  name              String
  tagline           String?
  description       String?
  categoryId        String
  status            VenueStatus       @default(DRAFT)
  rating            Float             @default(0)
  reviewCount       Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  communityId       String?
  bookings          Booking[]
  bookingConfig     BookingConfig?
  coupons           Coupon[]
  employees         Employee[]
  favorites         Favorite[]
  likes             Like[]
  media             Media[]
  portfolios        Portfolio[]
  reviews           Review[]
  serviceCategories ServiceCategory[]
  business          Business          @relation(fields: [businessId], references: [id])
  category          Category          @relation(fields: [categoryId], references: [id])
  community         Community?        @relation(fields: [communityId], references: [id])
  address           VenueAddress?
  contact           VenueContact?
  schedules         VenueSchedule[]

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
}

model VenueAddress {
  id         String @id @default(uuid())
  venueId    String @unique
  street     String
  suburb     String
  city       String
  region     String
  postalCode String
  country    String @default("South Africa")
  lat        Float?
  lng        Float?
  venue      Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model VenueContact {
  id        String  @id @default(uuid())
  venueId   String  @unique
  phone     String
  whatsapp  String?
  email     String
  website   String?
  instagram String?
  facebook  String?
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model BookingConfig {
  id                    String   @id @default(uuid())
  venueId               String   @unique
  instantConfirmation   Boolean  @default(true)
  acceptsOnlinePayments Boolean  @default(false)
  requiresDeposit       Boolean  @default(false)
  depositPercentage     Int      @default(0)
  cancellationPolicy    String?
  minimumNoticeMinutes  Int      @default(60)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  venue                 Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  icon        String?
  description String?
  imageUrl    String?
  status      CategoryStatus @default(ACTIVE)
  venues      Venue[]
}

model ServiceCategory {
  id        String    @id @default(uuid())
  venueId   String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, name])
  @@index([venueId])
}

model Service {
  id                String           @id @default(uuid())
  serviceCategoryId String
  name              String
  description       String?
  durationMinutes   Int
  bufferMinutes     Int              @default(0)
  price             Decimal          @db.Decimal(10, 2)
  priceIsFrom       Boolean          @default(false)
  popular           Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  bookingServices   BookingService[]
  category          ServiceCategory  @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  employees         Employee[]       @relation("EmployeeServices")

  @@index([serviceCategoryId])
}

model Employee {
  id              String                 @id @default(uuid())
  venueId         String
  name            String
  title           String?
  bio             String?
  imageUrl        String?
  rating          Float                  @default(0)
  reviewCount     Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  bookingServices BookingService[]
  venue           Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  availabilities  EmployeeAvailability[]
  schedules       EmployeeSchedule[]
  media           Media[]
  reviews         Review[]
  timeOff         TimeOff[]
  services        Service[]              @relation("EmployeeServices")

  @@index([venueId])
}

model VenueSchedule {
  id      String  @id @default(uuid())
  venueId String
  day     Int
  opens   String?
  closes  String?
  closed  Boolean @default(false)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, day])
}

model EmployeeSchedule {
  id         String   @id @default(uuid())
  employeeId String
  day        Int
  startTime  String?
  endTime    String?
  isWorking  Boolean  @default(true)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, day])
}

model EmployeeAvailability {
  id          String   @id @default(uuid())
  employeeId  String
  date        DateTime @db.Date
  startTime   String?
  endTime     String?
  isAvailable Boolean  @default(true)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model TimeOff {
  id         String   @id @default(uuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDate, endDate])
}

model Booking {
  id            String           @id @default(uuid())
  userId        String
  venueId       String
  date          DateTime         @db.Date
  startTime     String
  endTime       String
  durationTotal Int
  priceTotal    Decimal          @db.Decimal(10, 2)
  status        BookingStatus    @default(PENDING)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  user          User             @relation(fields: [userId], references: [id])
  venue         Venue            @relation(fields: [venueId], references: [id])
  services      BookingService[]
  payment       Payment?

  @@index([userId])
  @@index([venueId])
  @@index([venueId, date])
  @@index([status])
}

model BookingService {
  id              String    @id @default(uuid())
  bookingId       String
  serviceId       String
  employeeId      String?
  price           Decimal   @db.Decimal(10, 2)
  durationMinutes Int
  createdAt       DateTime  @default(now())
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee        Employee? @relation(fields: [employeeId], references: [id])
  service         Service   @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@index([serviceId])
  @@index([employeeId])
}

model Review {
  id           String    @id @default(uuid())
  userId       String
  venueId      String
  employeeId   String?
  rating       Int
  body         String?
  serviceName  String?
  employeeName String?
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
  employee     Employee? @relation(fields: [employeeId], references: [id])
  user         User      @relation(fields: [userId], references: [id])
  venue        Venue     @relation(fields: [venueId], references: [id])

  @@index([venueId])
  @@index([employeeId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([reviewId])
  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Media {
  id          String          @id @default(uuid())
  venueId     String?
  employeeId  String?
  portfolioId String?
  blogId      String?
  url         String
  alt         String?
  type        MediaType       @default(IMAGE)
  featured    Boolean         @default(false)
  entityType  MediaEntityType
  category    String?
  createdAt   DateTime        @default(now())
  blog        Blog?           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  employee    Employee?       @relation(fields: [employeeId], references: [id])
  portfolio   Portfolio?      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  venue       Venue?          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([employeeId])
  @@index([portfolioId])
  @@index([blogId])
}

model Portfolio {
  id          String   @id @default(uuid())
  venueId     String
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       Media[]
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model BlogCategory {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  blogs Blog[]
}

model Blog {
  id            String       @id @default(uuid())
  categoryId    String
  title         String
  slug          String       @unique
  content       String
  excerpt       String?
  featuredImage String?
  published     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  category      BlogCategory @relation(fields: [categoryId], references: [id])
  media         Media[]

  @@index([categoryId])
  @@index([published])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("ZAR")
  status        PaymentStatus @default(PENDING)
  provider      String?
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payout {
  id         String       @id @default(uuid())
  businessId String
  amount     Decimal      @db.Decimal(10, 2)
  status     PayoutStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model Coupon {
  id           String    @id @default(uuid())
  venueId      String
  code         String
  discount     Decimal   @db.Decimal(10, 2)
  isPercentage Boolean   @default(true)
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, code])
  @@index([venueId, active])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  venues      Venue[]
  members     User[]   @relation("CommunityMembers")

  @@index([status])
}

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  PLATFORM_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaEntityType {
  VENUE
  EMPLOYEE
  PORTFOLIO
  BLOG
  COMMUNITY
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum VenueStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}
